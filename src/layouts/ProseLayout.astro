---
/*
  Long-form text pages (The plan, About, Privacy, Accessibility…). Sits inside BaseLayout.
  Puts the title, an optional intro paragraph and the page text in a 65-character column,
  and ends with the date the page was last updated.
*/
import BaseLayout from "./BaseLayout.astro";
import { formatDate } from "../utils/dates";

interface Props {
  title: string;
  description?: string;
  // Optional intro paragraph under the title
  lead?: string;
  // From the page file's "updated" field
  updated?: Date;
  // Show "That's N days away." in the deadline strip (How to respond)
  showCountdown?: boolean;
}

const { title, description, lead, updated, showCountdown } = Astro.props;
---

<BaseLayout title={title} description={description} showCountdown={showCountdown}>
  <article class="prose">
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
    {updated && <p class="updated">Last updated {formatDate(updated)}.</p>}
  </article>
</BaseLayout>

<style>
  .prose {
    max-width: var(--measure);
  }

  .updated {
    margin-top: var(--space-7);
    color: var(--colour-text-muted);
    font-size: var(--text-sm);
  }
</style>
