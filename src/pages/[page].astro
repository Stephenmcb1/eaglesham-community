---
/*
  One page for each file in src/content/pages/, e.g. about.md becomes /about/.
  Pages marked draft: true only appear with npm run dev, never on the live site.
*/
import { getCollection, render } from "astro:content";
import ProseLayout from "../layouts/ProseLayout.astro";
import SourceList from "../components/SourceList.astro";

export async function getStaticPaths() {
  // Pages that have their own file in src/pages/ because they show extra things.
  // (This has to be inside getStaticPaths: Astro runs it separately from the rest of the file.)
  const pagesWithOwnRoute = ["the-plan", "respond"];
  const pages = await getCollection(
    "pages",
    ({ id, data }) => !pagesWithOwnRoute.includes(id) && (import.meta.env.DEV || !data.draft),
  );
  return pages.map((page) => ({ params: { page: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<ProseLayout title={page.data.title} description={page.data.description} updated={page.data.updated}>
  <Content />
  <SourceList sources={page.data.sources} />
</ProseLayout>
