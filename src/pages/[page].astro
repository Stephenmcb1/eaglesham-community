---
/*
  One page for each file in src/content/pages/, e.g. the-plan.md becomes /the-plan/.
  Pages marked draft: true only appear with npm run dev, never on the live site.
  TODO (Phase 1, step 4): move these into ProseLayout with the long-form page design.
*/
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const pages = await getCollection("pages", ({ data }) => import.meta.env.DEV || !data.draft);
  return pages.map((page) => ({ params: { page: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <h1>{page.data.title}</h1>
  <Content />
</BaseLayout>
