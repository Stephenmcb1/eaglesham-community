---
/*
  One page for each file in src/content/sites/, e.g. waulkers-loan.md becomes /sites/waulkers-loan/.
  TODO (Phase 1, step 5): add the breadcrumb, key facts panel, map and "Respond about this site" button.
*/
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SourceList from "../../components/SourceList.astro";

export async function getStaticPaths() {
  const sites = await getCollection("sites");
  return sites.map((site) => ({ params: { slug: site.id }, props: { site } }));
}

const { site } = Astro.props;
const { Content } = await render(site);
---

<BaseLayout title={site.data.title} description={site.data.summary}>
  <h1>{site.data.title}</h1>
  <p class="lead">{site.data.summary}</p>
  <Content />
  <SourceList sources={site.data.sources} />
</BaseLayout>

<style>
  .lead {
    font-size: var(--text-lead);
  }
</style>
