---
// Temporary holding page. Replaced by the real home page in Phase 1, step 8.
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
---

<BaseLayout showCountdown>
  <h1>{site.name}</h1>
  <p class="lead">
    This site is being built. It will explain what Local Development Plan 3 (LDP3) proposes for
    Eaglesham and Waterfoot, and how to respond.
  </p>
  <p>
    In the meantime, read about LDP3 on <a href={site.council.ldp3Page}
      >East Renfrewshire Council's website</a
    >.
  </p>
</BaseLayout>

<style>
  .lead {
    font-size: var(--text-lead);
  }
</style>
