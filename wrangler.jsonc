// Cloudflare Workers settings. The site is plain static files, so this only says where they are.
// https://developers.cloudflare.com/workers/static-assets/
{
  "name": "eaglesham-community",
  "compatibility_date": "2026-11-02",
  // The *.workers.dev address. It's the live site until a custom domain is added.
  "workers_dev": true,
  // A preview link for each branch and pull request, so changes can be checked before they go live
  "preview_urls": true,
  "assets": {
    // Astro builds the site into dist/
    "directory": "./dist",
    // Use our own 404 page (added in Phase 1, step 9) for addresses that don't exist
    "not_found_handling": "404-page"
  }
}
